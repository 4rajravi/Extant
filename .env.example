# Copy to .env and fill in. Every setting Extant reads is listed here. .env is git ignored.
#
# The two DSNs below match the docker compose development defaults and point at
# localhost only. Never put a production DSN or any API key in this file.

# ---- docker compose (local Postgres only; Extant itself ignores these)
EXTANT_PG_USER=extant
EXTANT_PG_PASSWORD=extant_dev
EXTANT_PG_DB=extant
EXTANT_PG_PORT=54329

# ---- database
# Index plane writer: creates and drops build schemas.
EXTANT_WRITER_DSN=postgresql://extant:extant_dev@localhost:54329/extant
# Serving plane reader, as the read only role. `make bootstrap` sets extant_reader's
# password to the one given here.
EXTANT_READER_DSN=postgresql://extant_reader:extant_reader_dev@localhost:54329/extant
# The build schema serving reads: idx_<corpus>_<YYYYMMDD>_<short git commit>.
EXTANT_BUILD_SCHEMA=

# ---- embeddings (Phase 2; decided 19 November 2026)
# openai, or test for deterministic hash vectors that cost nothing (tests, rehearsals).
EXTANT_EMBEDDING_PROVIDER=openai
EXTANT_EMBEDDING_MODEL=text-embedding-3-large
# Fixed by the halfvec(256) columns; part of the vec_cache key. OpenAI shortens server side.
EXTANT_EMBEDDING_DIM=256
EXTANT_EMBEDDING_QUANTISATION=float16
# Set in .env only, never here. Needed by embed (not by --dry-run) and by retrieval.
EXTANT_OPENAI_API_KEY=
# The OpenAI account's embedding limit in tokens per minute: 40000 on the free usage tier,
# 1000000 or more on a paid tier. embed paces its requests to stay under it.
EXTANT_EMBED_TOKENS_PER_MINUTE=40000
# EUR per USD for cost estimates (ECB reference rate, 11 November 2026: 1 EUR = 1.1127 USD).
EXTANT_EUR_PER_USD=0.90

# ---- generation (Phase 4): one provider, a cheap tier for parse and judge, a stronger one
# for compose, all built through LangChain's init_chat_model. Prices: extant/agent/pricing.py.
EXTANT_LLM_PROVIDER=anthropic
EXTANT_ROUTER_MODEL=claude-haiku-5-5
EXTANT_COMPOSER_MODEL=claude-opus-5-5
EXTANT_COMPOSER_EFFORT=medium
EXTANT_ANTHROPIC_API_KEY=

# ---- limits
EXTANT_DAILY_ANSWER_CAP=50

# ---- RBI corpus crawler (Phase 1)
# Sent in the User-Agent of every request to rbi.org.in: an email address or URL.
EXTANT_RBI_CRAWL_CONTACT=
# Root of the raw cache and the derived caches. Git ignored.
EXTANT_RBI_DATA_DIR=data/rbi
# Seconds between requests. 2 is the floor; a higher value only slows the crawl.
EXTANT_RBI_REQUEST_INTERVAL_SECONDS=2
EXTANT_RBI_TIMEOUT_SECONDS=60

# ---- publishing a build (Phase 3): Neon, for serving and the CI retrieval gate
# An owner connection to the target database. Never committed, never a CI secret.
EXTANT_PUBLISH_DSN=
# extant_reader on the target, with the password publish sets for it. The same value is the
# GitHub secret EXTANT_EVAL_READER_DSN the retrieval gate reads with.
EXTANT_PUBLISH_READER_DSN=
